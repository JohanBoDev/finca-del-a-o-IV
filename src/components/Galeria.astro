---
import { Picture, getImage } from 'astro:assets';

/**
 * Lee automáticamente todo lo que haya en src/assets/fotos/
 * No hay que registrar nada: tú sueltas los archivos ahí y aparecen.
 */
const modulos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/fotos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);

/**
 * Convierte el nombre del archivo en texto alternativo.
 * "01-piscina-noche.jpg" → "Piscina noche"
 *
 * Los nombres automáticos —WhatsApp, cámara, capturas, UUID del
 * exportador— no describen nada, así que ahí se usa un texto genérico.
 */
const NOMBRES_SIN_SENTIDO = /^(whatsapp|img|image|photo|foto|screenshot|captura|pxl|dsc)/i;
const ES_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const SOLO_NUMEROS_Y_SIMBOLOS = /^[\d\s\-_.]+$/;

const textoAlternativo = (ruta: string, indice: number) => {
  const sinExtension =
    ruta
      .split('/')
      .pop()
      ?.replace(/\.[^.]+$/, '')
      .trim() ?? '';

  const generico = `Finca Palma Azul — foto ${indice + 1}`;

  // Se evalúa el nombre crudo: si se limpiara primero, un UUID como
  // "51311171-de4b-..." perdería el bloque inicial y pasaría el filtro.
  if (
    !sinExtension ||
    ES_UUID.test(sinExtension) ||
    NOMBRES_SIN_SENTIDO.test(sinExtension) ||
    SOLO_NUMEROS_Y_SIMBOLOS.test(sinExtension)
  ) {
    return generico;
  }

  const limpio = sinExtension
    .replace(/^\d+[-_]\s*/, '')
    .replace(/[-_]/g, ' ')
    .trim();

  if (!limpio) return generico;

  return limpio.charAt(0).toUpperCase() + limpio.slice(1);
};

const fotos = await Promise.all(
  Object.entries(modulos)
    .sort(([a], [b]) => a.localeCompare(b, 'es', { numeric: true }))
    .map(async ([ruta, modulo], i) => {
      const imagen = modulo.default;

      // Versión grande para el visor a pantalla completa. Sin esto el
      // visor reusaría la miniatura del mosaico (~400 px de ancho) y se
      // vería borrosa al ampliar.
      const completa = await getImage({
        src: imagen,
        width: Math.min(imagen.width, 1600),
        format: 'webp',
        quality: 82,
      });

      return {
        imagen,
        alt: textoAlternativo(ruta, i),
        urlCompleta: completa.src,
        // Las verticales ocupan dos filas del mosaico. Así la grilla se
        // arma sola sin importar qué mezcle el usuario.
        vertical: imagen.height > imagen.width * 1.15,
      };
    }),
);
---

{
  fotos.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-humo/30 bg-noche-2/40 px-6 py-16 text-center">
      <p class="display-italic text-2xl text-humo sm:text-3xl">Fotos en camino</p>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-humo">
        Suelta las fotos de la finca en{' '}
        <code class="rounded bg-noche-3 px-2 py-1 text-neon">src/assets/fotos/</code> y aparecen
        aquí solas. No hay que tocar código.
      </p>
    </div>
  ) : (
    <>
      <div class="grid auto-rows-47.5 grid-cols-2 gap-3 sm:auto-rows-60 sm:grid-cols-3 sm:gap-4">
        {fotos.map(({ imagen, alt, vertical, urlCompleta }, i) => (
          <button
            type="button"
            data-lightbox={i}
            data-completa={urlCompleta}
            class={`group relative overflow-hidden rounded-xl border border-white/10 transition-all duration-300 hover:border-neon/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon ${
              vertical ? 'row-span-2' : ''
            }`}
            aria-label={`Ampliar foto: ${alt}`}
          >
            {/*
              AVIF primero, WebP de respaldo. Importa porque varias fotos
              ya vienen en AVIF: convertirlas solo a WebP las engordaba
              hasta un 60%.
            */}
            <Picture
              src={imagen}
              alt={alt}
              formats={['avif', 'webp']}
              widths={[400, 800, 1200]}
              sizes="(max-width: 640px) 50vw, 33vw"
              loading={i < 4 ? 'eager' : 'lazy'}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-t from-noche/70 via-transparent to-transparent opacity-70 transition-opacity group-hover:opacity-30" />
          </button>
        ))}
      </div>

      {/* Visor a pantalla completa */}
      <dialog
        id="visor"
        class="m-0 h-full max-h-none w-full max-w-none bg-noche/95 p-0 backdrop:bg-noche/90"
      >
        <div class="relative flex h-full w-full items-center justify-center p-4">
          <img id="visor-imagen" src="" alt="" class="max-h-full max-w-full object-contain" />

          <button
            id="visor-cerrar"
            type="button"
            class="absolute right-4 top-4 rounded-full border border-neon/50 bg-noche-2/80 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-neon transition-colors hover:bg-neon hover:text-noche"
          >
            Cerrar
          </button>

          <button
            id="visor-anterior"
            type="button"
            aria-label="Foto anterior"
            class="absolute left-3 rounded-full border border-white/20 bg-noche-2/80 px-4 py-3 text-hueso transition-colors hover:border-neon hover:text-neon"
          >
            ‹
          </button>

          <button
            id="visor-siguiente"
            type="button"
            aria-label="Foto siguiente"
            class="absolute right-3 rounded-full border border-white/20 bg-noche-2/80 px-4 py-3 text-hueso transition-colors hover:border-neon hover:text-neon"
          >
            ›
          </button>
        </div>
      </dialog>
    </>
  )
}

<script>
  const visor = document.getElementById('visor') as HTMLDialogElement | null;
  const visorImagen = document.getElementById('visor-imagen') as HTMLImageElement | null;
  const disparadores = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]'),
  );

  if (visor && visorImagen && disparadores.length > 0) {
    // La versión grande viene en data-completa. La miniatura del mosaico
    // ronda los 400 px de ancho y a pantalla completa se vería borrosa.
    const fuentes = disparadores.map((boton) => {
      const img = boton.querySelector('img');
      return {
        src: boton.dataset.completa || img?.currentSrc || img?.src || '',
        alt: img?.alt ?? '',
      };
    });

    let actual = 0;

    const mostrar = (indice: number) => {
      actual = (indice + fuentes.length) % fuentes.length;
      visorImagen.src = fuentes[actual].src;
      visorImagen.alt = fuentes[actual].alt;
    };

    disparadores.forEach((boton, i) => {
      boton.addEventListener('click', () => {
        mostrar(i);
        visor.showModal();
      });
    });

    document.getElementById('visor-cerrar')?.addEventListener('click', () => visor.close());
    document.getElementById('visor-anterior')?.addEventListener('click', () => mostrar(actual - 1));
    document.getElementById('visor-siguiente')?.addEventListener('click', () => mostrar(actual + 1));

    // Clic en el fondo cierra el visor.
    visor.addEventListener('click', (evento) => {
      if (evento.target === visor) visor.close();
    });

    document.addEventListener('keydown', (evento) => {
      if (!visor.open) return;
      if (evento.key === 'ArrowRight') mostrar(actual + 1);
      if (evento.key === 'ArrowLeft') mostrar(actual - 1);
    });
  }
</script>
