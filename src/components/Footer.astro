---
import { EVENTO } from '../config/evento';
---

<footer class="border-t border-white/8 px-5 py-14 text-center">
  <p class="display-italic text-2xl text-hueso sm:text-3xl">
    La Finca <span class="text-neon glow-neon">Del Año</span>
    <span class="text-electrico glow-electrico">{EVENTO.edicion}</span>
  </p>
  <div class="linea-neon mx-auto mt-6 w-32"></div>
  <p class="mt-6 text-xs uppercase tracking-[0.3em] text-humo">
    {EVENTO.fechaBreve} · {EVENTO.lugar}
  </p>
  <p class="mt-3 text-xs text-humo/60">Nos vemos allá 🌴</p>
</footer>
