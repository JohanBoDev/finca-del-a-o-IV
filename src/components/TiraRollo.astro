---
import { Picture } from 'astro:assets';

/**
 * Tira que corre sola con fotos del rollo de la IV, para la página de
 * la V: "así se vive". Toca cualquier foto y lleva al recuerdo completo.
 */
const modulos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/rollo-iv/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

// Solo las de la noche: son las que venden la fiesta.
const fotos = Object.entries(modulos)
  .sort(([a], [b]) => a.localeCompare(b, 'es', { numeric: true }))
  .slice(4, 22)
  .map(([, m]) => m.default);

const GIROS = [-2, 1.5, -1, 2.2, -1.8, 1];
---

<a
  href="/iv"
  class="tira group relative -mx-5 block overflow-hidden py-6 focus-visible:outline-2 focus-visible:outline-neon sm:-mx-8"
  aria-label="Ver las fotos de la Finca IV"
>
  <div class="carril flex w-max gap-5">
    {
      [...fotos, ...fotos].map((imagen, i) => (
        <span
          class="block w-36 shrink-0 bg-hueso p-1.5 pb-5 shadow-[0_8px_24px_rgba(0,0,0,0.5)] sm:w-48"
          style={`transform:rotate(${GIROS[i % GIROS.length]}deg)`}
          aria-hidden={i >= fotos.length ? 'true' : undefined}
        >
          <Picture
            src={imagen}
            alt=""
            formats={['avif', 'webp']}
            widths={[300]}
            sizes="192px"
            loading="lazy"
            class="block aspect-4/3 h-auto w-full object-cover"
          />
        </span>
      ))
    }
  </div>
</a>

<style>
  /* Bordes que se desvanecen con máscara, no con un degradado de color:
     así funciona sobre cualquier fondo (las auroras cambian de tono). */
  .tira {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .carril {
    animation: correr 70s linear infinite;
  }
  .tira:hover .carril {
    animation-play-state: paused;
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carril {
      animation: none;
    }
    .tira {
      overflow-x: auto;
    }
  }
</style>
