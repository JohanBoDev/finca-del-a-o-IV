---
import '../styles/global.css';
import FondoParticulas from '../components/FondoParticulas.astro';
import { EVENTO } from '../config/evento';

const titulo = `${EVENTO.nombre} ${EVENTO.edicion} · ${EVENTO.fechaBreve} de agosto`;
const descripcion = `${EVENTO.lugar} — ${EVENTO.ubicacion}. ${EVENTO.fechaTexto} · ${EVENTO.duracionTexto}, desde las ${EVENTO.horaTexto}. Piscina y música. Confirma tu cupo.`;

const base = Astro.site ?? new URL('http://localhost:4321/');

/**
 * Miniatura del link (public/og.jpg — el flyer montado sobre un lienzo
 * horizontal). Tres cosas importan y las tres están resueltas ahí:
 *
 *  · 1200x630. El flyer suelto es vertical y WhatsApp recorta las
 *    verticales a un cuadrito en vez de mostrar preview grande.
 *  · JPEG. WhatsApp no lee AVIF ni WebP en las previews.
 *  · URL fija, sin hash. WhatsApp cachea la preview por link, así que
 *    una ruta que cambia con cada build rompe el caché sin necesidad.
 *
 * Se genera aparte del build; ver la nota en el README.
 */
const OG = { ruta: '/og.jpg', ancho: 1200, alto: 630 };
const urlCanonica = new URL(Astro.url.pathname, base);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#070c16" />
    <link rel="canonical" href={urlCanonica} />

    <!-- Preview del link en WhatsApp / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${EVENTO.nombre} ${EVENTO.edicion}`} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(OG.ruta, base)} />
    <meta property="og:image:secure_url" content={new URL(OG.ruta, base)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG.ancho)} />
    <meta property="og:image:height" content={String(OG.alto)} />
    <meta property="og:image:alt" content={`Afiche de ${titulo}`} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={new URL(OG.ruta, base)} />

    <!-- Tipografías: Anton (display) + Inter (texto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <!-- Sin color de fondo propio: taparía el canvas de partículas.
       El color base vive en <html> (ver global.css). -->
  <body class="text-hueso antialiased">
    <FondoParticulas />
    <slot />
  </body>
</html>
